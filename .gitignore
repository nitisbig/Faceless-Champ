# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Generated media and tool caches
# Audio, video, and generated subtitles (at any directory depth)
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.aiff
*.aif
*.wma
*.mp4
*.m4v
*.mov
*.mkv
*.webm
*.avi
*.mpeg
*.mpg
*.wmv
media/
# Keep reusable sound effects shipped with the library/examples.
!assets/sfx/**/*.wav

output/
**/output/
**/image/
**/images/
# Keep the stock-analysis image folder while ignoring supplied/generated artwork.
!training project/stock-analysis/image/
training project/stock-analysis/image/*
!training project/stock-analysis/image/.gitkeep
.pytest_cache/
.ruff_cache/

# Map showcase previews
/media/maps/

# Track the guide site and its verified preview assets.
!website/dist/
!website/dist/**
