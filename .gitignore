*.png
media/
# Keep reusable library sound effects.
!assets/sfx/**/*.wav
# Required, source-controlled demonstration narration (not generated output).
!facelesschamp-kit/src/facelesschamp_kit/sample_assets/voiceover.wav
!examples/programming/hello_world/audio.mp3

output/
**/output/
**/image/
**/images/
.pytest_cache/
.ruff_cache/

# Track the generated API guide site.
!website/dist/
!website/dist/**

# Prepared browser frame caches
.web-cache/

